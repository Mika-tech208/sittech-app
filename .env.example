# Copie para .env.local (gitignored) e preencha com valores reais para rodar
# localmente.

# Supabase (projeto de desenvolvimento) — só URL e anon key, seguras pra
# expor no frontend (protegidas pelas policies de RLS). NUNCA colocar a
# service_role key num arquivo NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role — SERVER-ONLY. NUNCA prefixar com NEXT_PUBLIC_, nunca
# importar fora de Route Handlers (src/app/api/**). Usada pela Auth Admin
# API (criar usuário, redefinir senha de outro usuário).
SUPABASE_SERVICE_ROLE_KEY=
