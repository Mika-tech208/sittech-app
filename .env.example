# Copie para .env.local (gitignored) e preencha com valores reais para rodar
# localmente.

# Supabase (projeto de desenvolvimento) — só URL e anon key, seguras pra
# expor no frontend (protegidas pelas policies de RLS). NUNCA colocar a
# service_role key num arquivo NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role — SERVER-ONLY. NUNCA prefixar com NEXT_PUBLIC_, nunca
# importar fora de Route Handlers (src/app/api/**). Usada pela Auth Admin
# API (criar usuário, redefinir senha de outro usuário).
SUPABASE_SERVICE_ROLE_KEY=

# Sittech Intelligence V1 — SERVER-ONLY, nunca prefixar com NEXT_PUBLIC_.
# Chave da OpenAI (único provider desta V1, ver src/features/intelligence/providers/).
OPENAI_API_KEY=
# Modelo usado pelo Intelligence — opcional, default definido em
# src/features/intelligence/providers/index.ts (único ponto central).
SITTECH_INTELLIGENCE_MODEL=

# Notificações Push V1 (ocorrência de máquina) — par de chaves VAPID,
# gerado uma vez com `npx web-push generate-vapid-keys` (não é segredo do
# Vault, é local a cada ambiente/projeto). A pública também vai ao
# navegador (é assim que Web Push funciona) — a privada é SERVER-ONLY,
# nunca prefixar com NEXT_PUBLIC_, nunca sai de src/app/api/push/**.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato de referência exigido pelo protocolo Web Push (mailto: ou URL
# https:). A Apple valida isso de forma mais rígida que outros provedores —
# domínio .local (ou qualquer domínio não-real) é REJEITADO com 403
# "BadJwtToken" ao enviar pro Safari/iOS. Use um domínio real (ex.:
# https://sittech-app.vercel.app).
PUSH_VAPID_SUBJECT=
