# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Cópia de referência do sistema original (Etapa 0) — contém as senhas reais
# dos usuários em texto puro (array USUARIOS). Preservada em disco de
# propósito (ver docs/legacy/briefing-claude-code-fase0-1.md), mas fora do
# controle de versão. O briefing em si (sem senhas) continua versionado.
docs/legacy/sittech-custos.jsx
docs/legacy/files-original.zip

# backups locais do banco (scripts/backup-prod.sh) — contêm dados reais de
# negócio, nunca versionar. Ver scripts/BACKUP_RESTORE.md.
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
